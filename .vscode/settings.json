{
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/user",
        "${workspaceFolder}/stm32f10x_lib/CMSIS/CM3/CoreSupport",
        "${workspaceFolder}/stm32f10x_lib/CMSIS/CM3/DeviceSupport/ST/STM32F10x",
        "${workspaceFolder}/stm32f10x_lib/STM32F10x_StdPeriph_Driver/inc",
        "${workspaceFolder}/stm32f10x_lib/STM32F10x_StdPeriph_Driver"
    ],
    "C_Cpp.default.defines": [
        "STM32F10X_MD_VL",
        "USE_STDPERIPH_DRIVER",
        "HSE_VALUE=8000000",
        "RUN_FROM_FLASH=1"
    ]
}
